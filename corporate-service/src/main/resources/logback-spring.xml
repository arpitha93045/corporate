<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging strategy:
    - dev / h2 / test: human-readable single-line console output with the
      correlation id inline. Keeps local development readable.
    - prod: single-line JSON per log event so a log aggregator (Loki, CloudWatch,
      ELK, …) can index by field. The correlation id is emitted as "requestId".

  JSON is hand-rolled with a pattern layout rather than pulling in
  logstash-logback-encoder — no extra dependency, and the field set is small
  and fully under our control. %replace escapes the two characters that would
  break JSON in a free-text message/stacktrace: backslash and double-quote.
  Never log PII or secrets in messages — see the production-grade standard.
-->
<configuration>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>{"ts":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","logger":"%logger{40}","thread":"%thread","requestId":"%mdc{requestId:-}","msg":"%replace(%message){'[\\\\\"]','_'}","exception":"%replace(%rEx){'[\\\\\"]','_'}"}%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} [req=%mdc{requestId:-}] - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
