# Copy to .env and fill in real values before `docker compose up --build`.
# .env is gitignored — never commit real secrets.

# --- Edge / TLS -------------------------------------------------------------
# A real domain enables automatic HTTPS (Let's Encrypt). Use "localhost" for
# local testing (plain HTTP, self-signed).
SITE_ADDRESS=localhost
# Public URL used to build links in emails (e.g. the quote link). In prod this
# is your https:// domain.
APP_BASE_URL=http://localhost

# --- Database ---------------------------------------------------------------
POSTGRES_DB=corporate
POSTGRES_USER=corporate
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Auth -------------------------------------------------------------------
# Must be a strong secret of at least 32 bytes. Generate e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-a-strong-32-byte-minimum-secret
JWT_TTL_SECONDS=86400

# --- Stripe (REQUIRED on prod) ---------------------------------------------
# The backend REFUSES TO BOOT on the prod profile with the placeholder values
# below — set real test (sk_test_/whsec_) or live (sk_live_) keys.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=inr

# --- Mail (optional) --------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@your-domain.example
MAIL_ENQUIRIES_TO=enquiries@your-domain.example

# --- Admin bootstrap (optional) --------------------------------------------
# Promotes this already-registered user to ADMIN on each boot.
APP_ADMIN_EMAIL=

# --- AI gifting agent (optional; inert without a key) -----------------------
AGENT_ENABLED=false
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
